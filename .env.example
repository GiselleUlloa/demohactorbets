# ============================================================================
# OpenSource Finder AI - Configuración de Entorno (.env.example)
# Copia este archivo como `.env` en la raíz del proyecto:
#   cp .env.example .env
# NUNCA subas tu archivo `.env` con claves reales al repositorio.
# ============================================================================

# Proveedor de Gemma 4 (Opciones: "auto" | "ollama" | "google" | "demo")
# - "auto": Intenta usar Ollama local (gemma4:e4b) o Google AI Studio si hay API Key; si no, usa modo demo.
# - "ollama": Conecta al runtime local de Ollama (por defecto http://localhost:11434).
# - "google": Usa Google AI Studio / Gemini API con un modelo oficial Gemma 4.
# - "demo": Fuerza el modo demostración educativo sin llamadas externas.
GEMMA_PROVIDER=auto

# Configuración para Ollama Local (Recomendado para desarrollo local sin costo)
# Modelos oficiales Gemma 4 en Ollama: gemma4:e4b, gemma4:e2b, gemma4:12b, gemma4:26b-a4b, gemma4:31b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Configuración para Google AI Studio / Gemini API (Opcional en la nube)
# Modelos oficiales Gemma 4 en Gemini API: gemma-4-31b-it, gemma-4-26b-a4b-it, gemma-4-4b-it
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# Token opcional de GitHub para ampliar el límite de peticiones de la API de GitHub
GITHUB_TOKEN=
